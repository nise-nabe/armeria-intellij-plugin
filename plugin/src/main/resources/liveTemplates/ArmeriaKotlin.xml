<templateSet group="Armeria">
  <template name="armroute-kotlin" key="live.template.annotated.route.method.kotlin.description" resource-bundle="messages.ArmeriaBundle" value="@com.linecorp.armeria.server.annotation.Get(&quot;$PATH$&quot;)&#10;fun $NAME$($PARAMS$): String {&#10;    return &quot;$END$&quot;&#10;}" description="Annotated Armeria route method (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="PATH" expression="" defaultValue="/" alwaysStopAt="true"/>
    <variable name="NAME" expression="" defaultValue="handler" alwaysStopAt="true"/>
    <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="KOTLIN_CLASS" value="true"/></context>
  </template>
  <template name="armroute-kotlin-post" key="live.template.annotated.route.method.kotlin.post.json.description" resource-bundle="messages.ArmeriaBundle" value="@com.linecorp.armeria.server.annotation.Post(&quot;$PATH$&quot;)&#10;@com.linecorp.armeria.server.annotation.ConsumesJson&#10;@com.linecorp.armeria.server.annotation.ProducesJson&#10;fun $NAME$($PARAMS$): String {&#10;    return &quot;$END$&quot;&#10;}" description="Annotated Armeria POST JSON route method (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="PATH" expression="" defaultValue="/" alwaysStopAt="true"/>
    <variable name="NAME" expression="" defaultValue="create" alwaysStopAt="true"/>
    <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="KOTLIN_CLASS" value="true"/></context>
  </template>
  <template name="armroute-kotlin-suspend" key="live.template.annotated.route.method.kotlin.suspend.description" resource-bundle="messages.ArmeriaBundle" value="@com.linecorp.armeria.server.annotation.Get(&quot;$PATH$&quot;)&#10;suspend fun $NAME$($PARAMS$): String {&#10;    return &quot;$END$&quot;&#10;}" description="Annotated Armeria suspend route method (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="PATH" expression="" defaultValue="/" alwaysStopAt="true"/>
    <variable name="NAME" expression="" defaultValue="handler" alwaysStopAt="true"/>
    <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context><option name="KOTLIN_CLASS" value="true"/></context>
  </template>
  <template name="armsrv-kotlin" key="live.template.server.builder.kotlin.description" resource-bundle="messages.ArmeriaBundle" value="com.linecorp.armeria.server.Server.builder()&#10;    .http($PORT$)&#10;    .annotatedService($SERVICE$())&#10;    .build()&#10;    .start()&#10;    .join()" description="Armeria Server.builder skeleton (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="PORT" expression="" defaultValue="8080" alwaysStopAt="true"/>
    <variable name="SERVICE" expression="completeSmart()" defaultValue="MyService" alwaysStopAt="true"/>
    <context><option name="KOTLIN_STATEMENT" value="true"/></context>
  </template>
  <template name="armwc-kotlin" key="live.template.webclient.decorator.kotlin.description" resource-bundle="messages.ArmeriaBundle" value="com.linecorp.armeria.client.WebClient.builder(&quot;$URI$&quot;)&#10;    .decorator(com.linecorp.armeria.client.logging.LoggingClient.newDecorator())&#10;    .build()" description="Armeria WebClient with LoggingClient decorator (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="URI" expression="" defaultValue="http://localhost:8080" alwaysStopAt="true"/>
    <context><option name="KOTLIN_STATEMENT" value="true"/></context>
  </template>
  <template name="armrcex-kotlin" key="live.template.restclient.execute.kotlin.description" resource-bundle="messages.ArmeriaBundle" value="val $CLIENT$ = com.linecorp.armeria.client.RestClient.of(&quot;$URI$&quot;)&#10;kotlinx.coroutines.runBlocking {&#10;    val $RESPONSE$ = $CLIENT$.get(&quot;$PATH$&quot;)&#10;        .execute&lt;$TYPE$&gt;()&#10;    $END$&#10;}" description="Armeria RestClient coroutine execute (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="CLIENT" expression="" defaultValue="client" alwaysStopAt="true"/>
    <variable name="URI" expression="" defaultValue="http://localhost:8080" alwaysStopAt="true"/>
    <variable name="RESPONSE" expression="" defaultValue="response" alwaysStopAt="true"/>
    <variable name="PATH" expression="" defaultValue="/" alwaysStopAt="true"/>
    <variable name="TYPE" expression="" defaultValue="String" alwaysStopAt="true"/>
    <context><option name="KOTLIN_STATEMENT" value="true"/></context>
  </template>
  <template name="armccs-kotlin" key="live.template.coroutine.context.service.kotlin.description" resource-bundle="messages.ArmeriaBundle" value=".annotatedService()&#10;    .decorator(com.linecorp.armeria.server.kotlin.CoroutineContextService.newDecorator { ctx -&gt;&#10;        kotlinx.coroutines.CoroutineName(ctx.config().defaultServiceNaming().serviceName(ctx) ?: &quot;$NAME$&quot;)&#10;    })&#10;    .build($SERVICE$())" description="Armeria CoroutineContextService decorator (Kotlin)" toReformat="true" toShortenFQNames="true">
    <variable name="NAME" expression="" defaultValue="name" alwaysStopAt="true"/>
    <variable name="SERVICE" expression="completeSmart()" defaultValue="MyService" alwaysStopAt="true"/>
    <context>
      <option name="KOTLIN_STATEMENT" value="true"/>
      <option name="KOTLIN_EXPRESSION" value="true"/>
    </context>
  </template>
</templateSet>
