<idea-plugin require-restart="false">
    <id>com.linecorp.armeria</id>
    <name>Armeria</name>
    <vendor email="nise.nabe@gmail.com" url="https://github.com/nise-nabe/armeria-intellij-plugin">nise_nabe</vendor>

    <extensionPoints>
        <extensionPoint qualifiedName="com.linecorp.intellij.armeria.protoRouteCollector"
                        interface="com.linecorp.intellij.plugins.armeria.explorer.protocol.ArmeriaProtoRouteCollector"
                        dynamic="true"/>
    </extensionPoints>

    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <depends optional="true" config-file="kotlin-integration.xml">org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="grpc-integration.xml">com.intellij.grpc</depends>
    <depends optional="true" config-file="proto-integration.xml">idea.plugin.protoeditor</depends>
    <depends optional="true" config-file="yaml-integration.xml">org.jetbrains.plugins.yaml</depends>
    <depends optional="true" config-file="properties-integration.xml">com.intellij.properties</depends>

    <extensions defaultExtensionNs="com.intellij">
        <moduleBuilder builderClass="com.linecorp.intellij.plugins.armeria.module.ArmeriaModuleBuilder" />
        <framework.type implementation="com.linecorp.intellij.plugins.armeria.framework.ArmeriaFrameworkEx" />
        <spellchecker.bundledDictionaryProvider implementation="com.linecorp.intellij.plugins.armeria.ArmeriaDictionaryProvider" />
        <deadCode implementation="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaMethodEntryPoint" />
        <toolWindow id="Armeria"
                    factoryClass="com.linecorp.intellij.plugins.armeria.explorer.ArmeriaExplorerToolWindowFactory"
                    anchor="right"
                    icon="/icons/armeria.svg"
                    canCloseContents="false" />
        <toolWindow id="Armeria Spring Boot Config"
                    factoryClass="com.linecorp.intellij.plugins.armeria.springboot.config.ArmeriaSpringBootConfigToolWindowFactory"
                    anchor="right"
                    icon="/icons/armeria.svg" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.duplicate.registration.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaDuplicateRegistration"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaDuplicateRegistrationInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.duplicate.route.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaDuplicateRoute"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaDuplicateRouteInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.param.path.variable.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaParamPathVariable"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaParamPathVariableInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.missing.blocking.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaMissingBlocking"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaMissingBlockingInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.decorator.order.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaClientDecoratorOrder"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientDecoratorOrderInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.server.decorator.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaServerDecorator"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaServerDecoratorInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.parameters.flag.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaParametersCompiler"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaParametersCompilerInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.annotation.processor.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaAnnotationProcessor"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaAnnotationProcessorInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.missing.docservice.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaMissingDocService"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaMissingDocServiceInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.server.limits.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaServerLimits"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaServerLimitsInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.client.resilience.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaClientResilience"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientResilienceInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.client.factory.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaClientFactoryReuse"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientFactoryReuseInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.endpoint.group.close.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaEndpointGroupClose"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaEndpointGroupCloseInspection" />
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.flags.provider.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaFlagsProviderSpi"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaFlagsProviderSpiInspection" />
        <notificationGroup id="armeria.notifications"
                           displayType="BALLOON"
                           bundle="messages.ArmeriaBundle"
                           key="notification.group.armeria" />
        <consoleFilterProvider implementation="com.linecorp.intellij.plugins.armeria.run.ArmeriaDocServiceConsoleFilterProvider" />
        <registryKey key="armeria.route.explorer.metrics"
                     defaultValue="false"
                     restartRequired="false"
                     description="Log Armeria Route Explorer collection metrics at INFO level"/>
        <registryKey key="armeria.grpc.proto.routes.enabled"
                     defaultValue="true"
                     restartRequired="false"
                     description="Include gRPC routes parsed from .proto files in Route Explorer"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.marker.ArmeriaJavaRouteLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.marker.ArmeriaJavaClientRouteLineMarkerProvider"/>
        <localInspection language="JAVA"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.blocking.client.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaBlockingClient"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.test.ArmeriaBlockingClientInspection" />
        <codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.test.ArmeriaJUnitServerExtensionLineMarkerProvider" />
        <gotoRelatedProvider implementation="com.linecorp.intellij.plugins.armeria.editor.ArmeriaRouteGotoRelatedProvider" />
        <microservices.endpointsProvider
                implementation="com.linecorp.intellij.plugins.armeria.explorer.endpoints.ArmeriaEndpointsProvider"/>
        <microservices.endpointsProvider
                implementation="com.linecorp.intellij.plugins.armeria.client.ArmeriaClientEndpointsProvider"/>

        <!-- Debugger renderers (string FQCNs only; Armeria types load in the debuggee) -->
        <debugger.compoundRendererProvider
                implementation="com.linecorp.intellij.plugins.armeria.debugger.ArmeriaServiceRequestContextRendererProvider"/>
        <debugger.compoundRendererProvider
                implementation="com.linecorp.intellij.plugins.armeria.debugger.ArmeriaClientRequestContextRendererProvider"/>

        <!-- Run configuration -->
        <configurationType implementation="com.linecorp.intellij.plugins.armeria.run.ArmeriaRunConfigurationType" />
        <runConfigurationProducer implementation="com.linecorp.intellij.plugins.armeria.run.ArmeriaRunConfigurationProducer" />


        <defaultLiveTemplates file="liveTemplates/Armeria.xml"/>
        <intentionAction>
            <className>com.linecorp.intellij.plugins.armeria.intention.ArmeriaGenerateRouteMethodIntention</className>
            <category>Armeria</category>
            <language>JAVA</language>
        </intentionAction>
        <intentionAction>
            <className>com.linecorp.intellij.plugins.armeria.intention.ArmeriaGeneratePostJsonRouteMethodIntention</className>
            <category>Armeria</category>
            <language>JAVA</language>
        </intentionAction>
        <completion.contributor language="JAVA"
                                implementationClass="com.linecorp.intellij.plugins.armeria.completion.ArmeriaAnnotationValueCompletionContributor"/>
        <psi.referenceContributor language="JAVA"
                                  implementation="com.linecorp.intellij.plugins.armeria.completion.ArmeriaJavaParamReferenceContributor"/>
        <psi.referenceContributor language="JAVA"
                                  implementation="com.linecorp.intellij.plugins.armeria.completion.ArmeriaJavaClassValuedReferenceContributor"/>
    </extensions>

    <actions>

    </actions>
</idea-plugin>
