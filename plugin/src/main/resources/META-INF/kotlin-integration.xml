<idea-plugin>
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.duplicate.route.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaDuplicateRouteKotlin"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaDuplicateRouteKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.param.path.variable.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaParamPathVariableKotlin"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaParamPathVariableKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.missing.blocking.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaMissingBlockingKotlin"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaMissingBlockingKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.decorator.order.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaClientDecoratorOrderKotlin"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientDecoratorOrderKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.server.decorator.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaServerDecoratorKotlin"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaServerDecoratorKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.parameters.flag.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaParametersCompilerKotlin"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaParametersCompilerKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.annotation.processor.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaAnnotationProcessorKotlin"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaAnnotationProcessorKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.missing.armeria.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaSuspendWithoutKotlin"
                         enabledByDefault="true"
                         level="WEAK WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaSuspendWithoutKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.missing.docservice.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaMissingDocServiceKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaMissingDocServiceKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.server.limits.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaServerLimitsKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaServerLimitsKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.client.resilience.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaClientResilienceKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientResilienceKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.client.factory.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaClientFactoryReuseKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaClientFactoryReuseKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.endpoint.group.close.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaEndpointGroupCloseKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaEndpointGroupCloseKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.production.flags.provider.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria.production"
                         shortName="ArmeriaFlagsProviderSpiKotlin"
                         enabledByDefault="false"
                         level="INFORMATION"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaFlagsProviderSpiKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.duplicate.registration.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaDuplicateRegistrationKotlin"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.inspection.ArmeriaDuplicateRegistrationKotlinInspection" />
        <localInspection language="kotlin"
                         bundle="messages.ArmeriaBundle"
                         key="inspection.blocking.client.kotlin.display.name"
                         groupBundle="messages.ArmeriaBundle"
                         groupKey="inspection.group.armeria"
                         shortName="ArmeriaBlockingClientKotlin"
                         enabledByDefault="true"
                         level="WARNING"
                         implementationClass="com.linecorp.intellij.plugins.armeria.test.ArmeriaBlockingClientKotlinInspection" />
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.marker.ArmeriaKotlinRouteLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.marker.ArmeriaKotlinClientRouteLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="kotlin"
                                        implementationClass="com.linecorp.intellij.plugins.armeria.test.ArmeriaKotlinJUnitServerExtensionLineMarkerProvider" />
        <defaultLiveTemplates file="liveTemplates/ArmeriaKotlin.xml"/>
        <intentionAction>
            <className>com.linecorp.intellij.plugins.armeria.intention.ArmeriaGenerateRouteMethodKotlinIntention</className>
            <category>Armeria</category>
            <language>kotlin</language>
        </intentionAction>
        <intentionAction>
            <className>com.linecorp.intellij.plugins.armeria.intention.ArmeriaGeneratePostJsonRouteMethodKotlinIntention</className>
            <category>Armeria</category>
            <language>kotlin</language>
        </intentionAction>
        <completion.contributor language="kotlin"
                                implementationClass="com.linecorp.intellij.plugins.armeria.completion.ArmeriaKotlinAnnotationValueCompletionContributor"/>
        <psi.referenceContributor language="kotlin"
                                  implementation="com.linecorp.intellij.plugins.armeria.completion.ArmeriaKotlinParamReferenceContributor"/>
        <psi.referenceContributor language="kotlin"
                                  implementation="com.linecorp.intellij.plugins.armeria.completion.ArmeriaKotlinClassValuedReferenceContributor"/>
    </extensions>
</idea-plugin>
