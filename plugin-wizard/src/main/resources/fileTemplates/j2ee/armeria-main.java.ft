package ${context.rootPackage};

#if ($context.hasLibrary("armeria-spring-boot3-starter") || $context.hasLibrary("armeria-spring-boot3-autoconfigure") || $context.hasLibrary("armeria-spring-boot2-autoconfigure"))
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

@SpringBootApplication
public class Main {
    public static void main(String[] args) {
        SpringApplication.run(Main.class, args);
    }
}
#else
import com.linecorp.armeria.server.Server;
import com.linecorp.armeria.server.docs.DocService;
#if ($context.hasLibrary("armeria-grpc"))
import com.linecorp.armeria.server.grpc.GrpcService;
#end

public class Main {
    public static void main(String[] args) {
        Server server = Server.builder()
                .http(8080)
                .annotatedService(new BlogService())
                .serviceUnder("/docs", new DocService())
#if ($context.hasLibrary("armeria-grpc"))
                .service(GrpcService.builder()
                        .addService(new HelloServiceImpl())
                        .build())
#end
                .build();
        server.closeOnJvmShutdown();
        server.start().join();
    }
}
#end
