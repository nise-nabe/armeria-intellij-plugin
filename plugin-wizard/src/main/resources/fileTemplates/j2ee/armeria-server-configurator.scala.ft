package ${context.rootPackage}

import com.linecorp.armeria.server.ServerBuilder
import com.linecorp.armeria.spring.ArmeriaServerConfigurator
#if ($context.hasLibrary("armeria-grpc"))
import com.linecorp.armeria.server.grpc.GrpcService
#end
import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

@Configuration
class ArmeriaConfiguration {
  @Bean
  def armeriaServerConfigurator(blogService: BlogService): ArmeriaServerConfigurator = {
    new ArmeriaServerConfigurator {
      override def configure(sb: ServerBuilder): Unit = {
        sb.annotatedService(blogService)
#if ($context.hasLibrary("armeria-grpc"))
        sb.service(GrpcService.builder()
          .addService(new HelloServiceImpl())
          .build())
#end
      }
    }
  }
}
