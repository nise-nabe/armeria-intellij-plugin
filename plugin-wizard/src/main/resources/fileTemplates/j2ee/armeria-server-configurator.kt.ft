package ${context.rootPackage}

import com.linecorp.armeria.server.docs.DocService
import com.linecorp.armeria.spring.ArmeriaServerConfigurator
#if ($context.hasLibrary("armeria-grpc"))
import com.linecorp.armeria.server.grpc.GrpcService
#end
import org.springframework.context.annotation.Bean
import org.springframework.context.annotation.Configuration

@Configuration
open class ArmeriaConfiguration {
    @Bean
    open fun armeriaServerConfigurator(blogService: BlogService): ArmeriaServerConfigurator {
        return ArmeriaServerConfigurator { sb ->
            sb.annotatedService(blogService)
            sb.serviceUnder("/docs", DocService())
#if ($context.hasLibrary("armeria-grpc"))
            sb.service(
                GrpcService.builder()
                    .addService(HelloServiceImpl())
                    .build(),
            )
#end
        }
    }
}
